# Copy this file to .env and fill in your actual API key.
# NEVER commit your real .env file -- it is already excluded via .gitignore.

# Required: get a FREE key (no credit card needed) at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

