# Streamlit Community Cloud secrets — DO NOT commit a real secrets.toml.
#
# This file is a template only. On share.streamlit.io, go to:
#   Your app -> Settings -> Secrets -> paste the contents below (with your
#   real key) -> Save. The app reads this automatically via st.secrets.
#
# Locally, you do NOT need this file — local runs (cli.py / streamlit run
# app.py on your machine) read GEMINI_API_KEY from .env instead.

GEMINI_API_KEY = "your-actual-gemini-api-key-here"

# Optional overrides (defaults shown — safe to omit)
# GEMINI_MODEL = "gemini-2.5-flash"
# EMBEDDING_MODEL_NAME = "all-MiniLM-L6-v2"
# CHUNK_SIZE = 800
# CHUNK_OVERLAP = 150
# DEFAULT_TOP_K = 5
# MAX_TOKENS = 1024
